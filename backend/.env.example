DATABASE_URL=sqlite:///./shopswift.db
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Optional: set these to bootstrap an administrator with your own credentials.
# INITIAL_ADMIN_EMAIL=your-admin-email@example.com
# INITIAL_ADMIN_PASSWORD=use-a-unique-strong-password
# INITIAL_ADMIN_NAME=Store Administrator
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Cashfree Payment Gateway (use sandbox credentials while developing)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_MODE=sandbox
CASHFREE_API_VERSION=2026-01-01
CASHFREE_WEBHOOK_URL=
FRONTEND_URL=http://localhost:5173
